# Vorlage: kopieren nach .streamlit/secrets.toml (lokal) bzw. in Streamlit Cloud unter
# App -> Settings -> Secrets einfügen. Die echte secrets.toml NIE committen.

OPENROUTER_API_KEY = "sk-or-..."

# Optional, nur ohne [google_drive]: lokaler Datenordner (Standard: <Projekt>/data)
# BELEG_DATENORDNER = "/pfad/zum/ordner"

# --- Google-Login (st.login) ----------------------------------------------
[auth]
# lokal: http://localhost:8501/oauth2callback
redirect_uri = "https://DEINE-APP.streamlit.app/oauth2callback"
# langer Zufallswert: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "..."
client_id = "....apps.googleusercontent.com"
client_secret = "GOCSPX-..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# --- Wer darf rein? Leere Liste = NIEMAND ------------------------------------
[zugang]
erlaubte_emails = ["du@gmail.com", "kollege@firma.de"]

# --- Ablage in Google Drive (ein gemeinsamer Ordner für alle Benutzer) ------
[google_drive]
# aus der Ordner-URL: https://drive.google.com/drive/folders/<ordner_id>
ordner_id = "..."
# einmalig lokal erzeugen: python drive_token_holen.py
refresh_token = "1//..."
# client_id / client_secret optional – fehlen sie, werden die aus [auth] benutzt

# --- Öffentliche Datenschutzseite: <app-url>/?seite=datenschutz ---------------
[datenschutz]
verantwortlicher = "Vorname Nachname, Straße, PLZ Ort"
kontakt = "du@gmail.com"
